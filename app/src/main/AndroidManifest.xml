<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="smellymoo.sand"
    android:versionCode="86"
    android:versionName="0.86">

    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="34" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar">

        <activity
            android:name=".Main"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".Sand" android:screenOrientation="portrait" android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity android:name=".Editor" android:screenOrientation="portrait" android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity android:name=".About" android:parentActivityName=".Main" />
        <activity android:name=".Settings" android:parentActivityName=".Main" />
        <activity android:name=".Help" android:parentActivityName=".Main" />
        <activity android:name=".Freemium" android:theme="@android:style/Theme.Dialog" android:parentActivityName=".Sand" />
        <activity android:name=".Diagnostic" android:theme="@android:style/Theme.Dialog" android:parentActivityName=".Main" />
        <activity android:name=".Settings_popup" android:theme="@android:style/Theme.Dialog" android:parentActivityName=".Sand" />

    </application>
</manifest>
