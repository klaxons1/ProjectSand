<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <SurfaceView android:id="@+id/sand_view" android:layout_width="match_parent" android:layout_height="0.000000px" android:layout_above="@+id/scroll_tools" android:layout_alignParentTop="true"/>
  <HorizontalScrollView android:id="@+id/scroll_tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true">
    <TableLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
      <TableRow android:id="@+id/tableRow1" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageButton android:id="@+id/tool_rotate" android:padding="1.000000dip" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/rotate" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/rotate"/>
        <ImageButton android:id="@+id/tool_save" android:padding="1.000000dip" android:visibility="gone" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/save" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/save"/>
        <ImageButton android:id="@+id/tool_zoom" android:padding="1.000000dip" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/zoom" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/zoom"/>
        <ImageButton android:id="@+id/tool_spouts" android:padding="1.000000dip" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/spouts" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/spouts"/>
        <ImageButton android:id="@+id/tool_eraser" android:padding="1.000000dip" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/eraser" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/eraser"/>
        <include layout="@layout/elements1"/>
        <Button android:id="@+id/tool_fix" android:padding="1.000000dip" android:visibility="gone" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:text="Fix" android:onClick="tool" android:contentDescription="@string/debug"/>
      </TableRow>
      <TableRow android:id="@+id/tableRow2" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageButton android:id="@+id/tool_clear" android:padding="1.000000dip" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/clear" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/clear"/>
        <ImageButton android:id="@+id/tool_borders" android:padding="1.000000dip" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/borders" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/borders"/>
        <ImageButton android:id="@+id/tool_slomo" android:padding="1.000000dip" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/pause" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/speed"/>
        <ImageButton android:id="@+id/tool_settings" android:padding="1.000000dip" android:visibility="gone" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:src="@drawable/cog" android:scaleType="centerInside" android:onClick="tool" android:contentDescription="@string/settings"/>
        <include layout="@layout/elements2"/>
        <Button android:id="@+id/tool_debug" android:padding="1.000000dip" android:visibility="gone" android:layout_width="64.000000dip" android:layout_height="64.000000dip" android:text="Debug" android:onClick="tool" android:contentDescription="@string/debug"/>
      </TableRow>
    </TableLayout>
  </HorizontalScrollView>
</RelativeLayout>
