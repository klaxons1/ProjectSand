<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/page">
  <TextView android:id="@+id/settings_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_title" style="@style/title"/>
  <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_above="@+id/setting_buttons" android:layout_below="@+id/settings_title" android:layout_centerHorizontal="true">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView android:textAppearance="?android:attr/textAppearanceMedium" android:paddingTop="10.000000dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_general"/>
      <View android:background="#FF888888" android:layout_width="match_parent" android:layout_height="2.000000dip"/>
      <CheckedTextView android:id="@+id/option_show_pro" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/setting_show_pro" style="@style/tick_right"/>
      <TextView android:textAppearance="?android:attr/textAppearanceMedium" android:paddingTop="10.000000dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_background"/>
      <View android:background="#FF888888" android:layout_width="match_parent" android:layout_height="2.000000dip"/>
      <RadioGroup android:id="@+id/option_background" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <RadioButton android:id="@+id/option_background_black" android:checked="true" android:text="@string/black" style="@style/radio"/>
        <RadioButton android:id="@+id/option_background_grey" android:text="@string/grey" style="@style/radio"/>
        <RadioButton android:id="@+id/option_background_purple" android:text="@string/purple" style="@style/radio"/>
        <RadioButton android:id="@+id/option_background_blue" android:text="@string/blue" style="@style/radio"/>
      </RadioGroup>
      <TextView android:textAppearance="?android:attr/textAppearanceMedium" android:paddingTop="10.000000dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_toolbox"/>
      <View android:background="#FF888888" android:layout_width="match_parent" android:layout_height="2.000000dip"/>
      <RadioGroup android:id="@+id/option_toolbox" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <RadioButton android:id="@+id/option_toolbox_normal" android:checked="true" android:text="@string/toolbox_normal" style="@style/radio"/>
        <RadioButton android:id="@+id/option_toolbox_one" android:text="@string/toolbox_single" style="@style/radio"/>
        <RadioButton android:id="@+id/option_toolbox_color" android:visibility="gone" android:text="@string/toolbox_color" style="@style/radio"/>
      </RadioGroup>
      <TextView android:textAppearance="?android:attr/textAppearanceMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_mode"/>
      <View android:background="#FF888888" android:layout_width="match_parent" android:layout_height="2.000000dip"/>
      <RadioGroup android:id="@+id/option_engine" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <RadioButton android:id="@+id/option_engine_normal" android:checked="true" android:text="@string/engine_normal" style="@style/radio"/>
        <RadioButton android:id="@+id/option_engine_onesim" android:text="@string/engine_one" style="@style/radio"/>
        <RadioButton android:enabled="false" android:id="@+id/option_engine_first" android:text="@string/engine_first" style="@style/radio"/>
        <RadioButton android:id="@+id/option_engine_diag" android:visibility="gone" android:text="@string/engine_diag" style="@style/radio"/>
        <RadioButton android:enabled="false" android:id="@+id/option_engine_debug" android:text="@string/engine_debug" style="@style/radio"/>
      </RadioGroup>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:id="@+id/setting_buttons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true">
    <Button android:id="@+id/back_button" android:text="@string/button_back" android:onClick="click" style="@style/button"/>
    <Button android:id="@+id/save_button" android:text="@string/button_save" android:onClick="click" style="@style/button"/>
  </LinearLayout>
</RelativeLayout>
